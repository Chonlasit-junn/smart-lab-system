# ==============================
# Project-wide Git Ignore Rules
# ==============================

# --- Node / Frontend ---
node_modules/
dist/
frontend/dist-*/
smart-lab-agent/build_*/
smart-lab-agent/dist_*/
gatekeeper/build_msi/*/pyinstaller-work/
gatekeeper/build_msi/*/payload/
gatekeeper/build_msi/*/spec/
build/
.npm/

# --- Installers and compiled applications (keep out of Git) ---
*.exe
*.msi

# --- Python / Backend / Gatekeeper / Agent ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.pkl
*.dat
*.pth

# --- Runtime and biometric data (never commit) ---
backend/runtime/
backend/uploads/
gatekeeper/runtime/
gatekeeper/known_faces/
gatekeeper/embeddings_cache.pkl

# --- Secrets & Configs ---
.env
.env.*
!.env.example
!.env.*.example
*.db        # ละเว้นไฟล์ Database

# --- OS Files ---
.DS_Store
Thumbs.db
.vs/
*.suo
*.user
